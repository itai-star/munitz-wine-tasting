generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wine {
  id          String   @id @default(cuid())
  name        String
  year        Int?
  type        String?
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tastingSessions TastingSessionWine[]
}

model TastingSession {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @default(now())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wines       TastingSessionWine[]
  ratings     Rating[]
  impressions Impression[]
}

model TastingSessionWine {
  id        String @id @default(cuid())
  sessionId String
  wineId    String
  order     Int    @default(0)

  session TastingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  wine    Wine           @relation(fields: [wineId], references: [id], onDelete: Cascade)
  ratings Rating[]

  @@unique([sessionId, wineId])
}

model Rating {
  id              String @id @default(cuid())
  sessionWineId   String
  sessionId       String
  participantName String
  score           Int
  notes           String?
  createdAt       DateTime @default(now())

  sessionWine TastingSessionWine @relation(fields: [sessionWineId], references: [id], onDelete: Cascade)
  session     TastingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionWineId, participantName])
}

model Impression {
  id              String   @id @default(cuid())
  sessionId       String
  participantName String
  text            String
  createdAt       DateTime @default(now())

  session TastingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantName])
}
