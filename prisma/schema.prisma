generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wine {
  id          String   @id @default(cuid())
  name        String
  year        Int?
  type        String?
  description String?
  imageUrl    String?
  price       Int?
  quantity    Int      @default(0)
  barcode     String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tastingSessions TastingSessionWine[]
  withdrawals     WineWithdrawal[]
}

model WineWithdrawal {
  id        String   @id @default(cuid())
  wineId    String
  quantity  Int
  createdAt DateTime @default(now())

  wine Wine @relation(fields: [wineId], references: [id], onDelete: Cascade)
}

model TastingSession {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @default(now())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wines       TastingSessionWine[]
  ratings     Rating[]
  impressions Impression[]
}

model TastingSessionWine {
  id        String @id @default(cuid())
  sessionId String
  wineId    String
  order     Int    @default(0)

  session TastingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  wine    Wine           @relation(fields: [wineId], references: [id], onDelete: Cascade)
  ratings Rating[]

  @@unique([sessionId, wineId])
}

model Rating {
  id              String @id @default(cuid())
  sessionWineId   String
  sessionId       String
  participantName String
  score           Int
  notes           String?
  createdAt       DateTime @default(now())

  sessionWine TastingSessionWine @relation(fields: [sessionWineId], references: [id], onDelete: Cascade)
  session     TastingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionWineId, participantName])
}

model Impression {
  id              String   @id @default(cuid())
  sessionId       String
  participantName String
  text            String
  createdAt       DateTime @default(now())

  session TastingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantName])
}

model Vintage {
  id        String   @id @default(cuid())
  year      Int      @unique
  label     String
  createdAt DateTime @default(now())

  samples       RipenessSample[]
  batches       FermentationBatch[]
  intakes       GrapeIntake[]
  finishedWines FinishedWine[]
  blockPrices   BlockVintagePrice[]
  paymentPlans  GrowerPaymentPlan[]
  freshWines    FreshAllocation[]
}

model VineyardBlock {
  id                     String   @id @default(cuid())
  name                   String
  location               String?
  elevationMeters        Int?
  slopeDirection         String?
  slopeAngleDegrees      Float?
  soilType               String?
  variety                String
  rootstock              String?
  plantingYear           Int?
  plantingDensity        String?
  rowDirection           String?
  trellisMethod          String?
  irrigationType         String?
  estimatedYieldPerDunam Float?
  diseaseHistory         String?
  // The grower who sold us this block's grapes, and the default price per kg in agorot.
  // A price can be set for a single vintage too, which then wins over this one.
  growerId               String?
  pricePerKgAgorot       Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  grower        Grower?  @relation(fields: [growerId], references: [id], onDelete: SetNull)
  vintagePrices BlockVintagePrice[]
  samples       RipenessSample[]
  fermentations FermentationBatchBlock[]
  intakes       GrapeIntake[]
  finishedWines FinishedWine[]
  stations      EcowittStation[]
}

model RipenessSample {
  id                String   @id @default(cuid())
  vintageId         String
  blockId           String
  sampleDate        DateTime
  brix              Float?
  ph                Float?
  titratableAcidity Float?
  clusterWeight     Int?
  color             String?
  createdAt         DateTime @default(now())

  vintage Vintage       @relation(fields: [vintageId], references: [id], onDelete: Cascade)
  block   VineyardBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([vintageId, blockId])
}

model FermentationBatch {
  id                   String    @id @default(cuid())
  vintageId            String
  tankName             String
  wineType             String?
  volumeLiters         Float?
  litersAfterPressing  Float?
  litersAfterSettling  Float?
  yeastStrain          String?
  startDate            DateTime
  endDate              DateTime?
  status               String    @default("active")
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  vintage  Vintage                  @relation(fields: [vintageId], references: [id], onDelete: Cascade)
  blocks   FermentationBatchBlock[]
  readings FermentationReading[]
}

model FermentationBatchBlock {
  id      String  @id @default(cuid())
  batchId String
  blockId String
  notes   String?

  batch FermentationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  block VineyardBlock     @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([batchId, blockId])
}

model GrapeIntake {
  id            String   @id @default(cuid())
  vintageId     String
  blockId       String
  intakeDate    DateTime
  totalWeightKg Float
  binCount      Int
  notes         String?
  createdAt     DateTime @default(now())

  vintage Vintage       @relation(fields: [vintageId], references: [id], onDelete: Cascade)
  block   VineyardBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([vintageId, blockId])
}

model FermentationReading {
  id                 String   @id @default(cuid())
  batchId            String
  readingDate        DateTime
  brix               Float?
  specificGravity    Float?
  temperatureCelsius Float?
  ph                 Float?
  yeastAdditions     String?
  cellarWork         String?
  so2Addition        String?
  tasteAromaNotes    String?
  createdAt          DateTime @default(now())

  batch FermentationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, readingDate])
}

// The kind of wine in a finished-wine record. FRESH is the light red style sold as "רענן".
enum FinishedWineType {
  RED
  WHITE
  ROSE
  FRESH
}

model FinishedWine {
  id                       String   @id @default(cuid())
  vintageId                String
  blockId                  String?
  tank                     String
  wineType                 FinishedWineType?
  harvestedWeightKg        Int
  litersAfterPressing      Int?
  litersAfterFirstRacking  Int?
  litersAfterSecondRacking Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  vintage Vintage        @relation(fields: [vintageId], references: [id], onDelete: Cascade)
  block   VineyardBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  labTests LabTest[]

  @@index([vintageId])
  @@index([blockId])
}

// A set of varieties approved to share a barrel when none of them has enough wine for a barrel of its own.
// A variety may belong to several combinations.
model BarrelCombination {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  varieties BarrelCombinationVariety[]
}

model BarrelCombinationVariety {
  id            String @id @default(cuid())
  combinationId String
  variety       String

  combination BarrelCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@unique([combinationId, variety])
  @@index([combinationId])
}

model LabTest {
  id             String   @id @default(cuid())
  finishedWineId String
  testDate       DateTime
  lab            String?
  density        Float?
  ethanol        Float?
  ph             Float?
  totalAcid      Float?
  volatile       Float?
  rsBx           Float?
  co2            Float?
  malicAcid      Float?
  notes          String?
  actionItems    String?
  createdAt      DateTime @default(now())

  finishedWine FinishedWine @relation(fields: [finishedWineId], references: [id], onDelete: Cascade)

  @@index([finishedWineId])
}

model RemoteMonitorSettings {
  id        String   @id @default("default")
  host      String
  username  String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RemoteSensorSample {
  id              String   @id @default(cuid())
  sensorKey       String
  sensorName      String
  temperatureC    Float?
  humidityPercent Float?
  recordedAt      DateTime @default(now())

  @@index([sensorKey, recordedAt])
}

model EcowittSettings {
  id             String   @id @default("default")
  applicationKey String
  apiKey         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EcowittStation {
  id        String         @id @default(cuid())
  name      String
  mac       String         @unique
  blockId   String?
  block     VineyardBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  sensorLabels EcowittSensorLabel[]
  samples      EcowittSample[]

  @@index([blockId])
}

model EcowittSensorLabel {
  stationId String
  sensorKey String
  label     String
  station   EcowittStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([stationId, sensorKey])
}

model EcowittSample {
  id                  String         @id @default(cuid())
  stationId           String
  sensorKey           String
  temperatureC        Float?
  humidityPercent     Float?
  soilMoisturePercent Float?
  leafWetnessPercent  Float?
  rainDailyMm         Float?
  recordedAt          DateTime       @default(now())
  station             EcowittStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, sensorKey, recordedAt])
}

model CreditAccess {
  id             String    @id @default("default")
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CreditCard {
  id        String   @id @default(cuid())
  name      String
  last4     String?
  createdAt DateTime @default(now())

  transactions CreditTransaction[]
}

model CreditTransaction {
  id                String   @id @default(cuid())
  cardId            String
  transactionDate   DateTime
  chargeDate        DateTime
  description       String
  amountAgorot      Int
  installmentNumber Int?
  installmentsTotal Int?
  category          String?
  categoryCode      String?
  dedupeKey         String
  importedAt        DateTime @default(now())

  card CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, dedupeKey])
  @@index([cardId, chargeDate])
}

enum UserRole {
  ADMIN
  USER
}

enum Permission {
  HARVEST
  INVENTORY
  REMOTE_CONTROL
  CREDIT
  TASTINGS
  SALES
  GROWERS
  EVENTS
  BARRELS
}

model AppUser {
  id                 String       @id @default(cuid())
  username           String       @unique
  passwordHash       String
  role               UserRole     @default(USER)
  permissions        Permission[]
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(false)
  failedAttempts     Int          @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions       UserSession[]
  resetRequests  PasswordResetRequest[]
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  userAgent  String?
  createdAt  DateTime @default(now())

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetRequest {
  id          String    @id @default(cuid())
  username    String
  userId      String?
  emailSent   Boolean   @default(false)
  requestedAt DateTime  @default(now())
  handledAt   DateTime?

  user AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([handledAt, requestedAt])
}

// Wine sales imported from the sales workbook. Amounts are in agorot and include VAT.
model SalesMonth {
  id                 String   @id @default(cuid())
  year               Int
  month              Int
  bottles            Int
  wineRevenueAgorot  Int
  sourceFile         String?
  importedAt         DateTime @default(now())

  sales SalesSale[]

  @@unique([year, month])
}

// One row of the workbook: a customer and what they bought in the month.
model SalesSale {
  id             String  @id @default(cuid())
  monthId        String
  name           String
  // PRIVATE or WHOLESALE; empty while the customer has not been classified.
  customerType   String?
  bottles        Int
  revenueAgorot  Int

  month SalesMonth      @relation(fields: [monthId], references: [id], onDelete: Cascade)
  items SalesSaleItem[]

  @@index([monthId])
  @@index([name])
}

// The part of a sale that belongs to one wine. The workbook records revenue per customer, not per wine,
// so a sale's revenue is divided between its wines by the number of bottles.
model SalesSaleItem {
  id             String @id @default(cuid())
  saleId         String
  wine           String
  bottles        Int
  revenueAgorot  Int

  sale SalesSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// What the app knows about a customer from earlier imports or from the user, used for months whose
// sheet has no customer type column.
model SalesCustomerRule {
  id           String   @id @default(cuid())
  name         String   @unique
  customerType String
  updatedAt    DateTime @updatedAt
}

// A grower we buy grapes from. Blocks point at their grower, so the list is chosen from, never typed.
model Grower {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  blocks       VineyardBlock[]
  paymentPlans GrowerPaymentPlan[]
}

// The price per kg of a block for one vintage. It wins over the block's default price.
model BlockVintagePrice {
  id               String @id @default(cuid())
  blockId          String
  vintageId        String
  pricePerKgAgorot Int

  block   VineyardBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  vintage Vintage       @relation(fields: [vintageId], references: [id], onDelete: Cascade)

  @@unique([blockId, vintageId])
}

// How one grower is paid for one vintage: the month of the first payment and the number of monthly payments.
model GrowerPaymentPlan {
  id               String @id @default(cuid())
  vintageId        String
  growerId         String
  // The month of the first payment, as YYYY-MM.
  firstMonth       String
  installmentCount Int

  vintage      Vintage             @relation(fields: [vintageId], references: [id], onDelete: Cascade)
  grower       Grower              @relation(fields: [growerId], references: [id], onDelete: Cascade)
  installments GrowerInstallment[]

  @@unique([vintageId, growerId])
}

// One monthly payment of a plan. It is paid once paidAt is set.
model GrowerInstallment {
  id           String    @id @default(cuid())
  planId       String
  sequence     Int
  dueMonth     String
  amountAgorot Int
  paidAt       DateTime?

  plan GrowerPaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, sequence])
  @@index([dueMonth])
}

// A kind of winery event, chosen from a list. The colour tells the kinds apart in the calendar.
model EventCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  events CalendarEvent[]
}

// An event on the winery calendar. Cancelling keeps it on the calendar, marked as cancelled.
model CalendarEvent {
  id          String    @id @default(cuid())
  categoryId  String
  details     String
  date        DateTime  @db.Date
  // Times of day as HH:MM, and the place; all optional.
  startTime   String?
  endTime     String?
  city        String?
  street      String?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([date])
}

// Liters of a variety that are set aside by hand as fresh wine for a vintage. They need no barrel,
// so the barrel plan leaves them out.
model FreshAllocation {
  id        String   @id @default(cuid())
  vintageId String
  variety   String
  liters    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vintage Vintage @relation(fields: [vintageId], references: [id], onDelete: Cascade)

  @@unique([vintageId, variety])
  @@index([vintageId])
}

// A barrel in the barrel room. Taking one out of stock keeps it, with the date, so the history is not lost.
model Barrel {
  id          String    @id @default(cuid())
  number      String    @unique
  type        String
  year        Int
  removedAt   DateTime?
  removalNote String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([removedAt])
}
